#include <stdio.h>

int pot (int, int);

int main (){
  int k, n;
  printf ("digite a base: ");
  scanf ("%d", &k);
  printf ("digite o expoente: ");
  scanf ("%d", &n);
  printf ("resultado: %d ", pot(k,n));
}

int pot (int k, int n){
 if (k==0){
   return 0;
 }
 if (n==0) {
    return 1;
  }
  else {
    return pot (k, n-1) * k;
  }
}
