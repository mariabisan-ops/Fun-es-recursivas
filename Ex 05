#include <stdio.h>

int fibonacci (int);

int main (){
  int n;
  printf ("digite o termo que deseja calcular: ");
  scanf ("%d", &n);
  printf ("n-esimo termo: %d", fibonacci (n));
}

int fibonacci (int n){
  if (n==1||n==2){
    return 1;
  }
  else {
    return fibonacci (n-1) + fibonacci (n-2);
  }
} 
