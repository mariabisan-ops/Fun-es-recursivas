#include <stdio.h>

void pares (int);

int main (){
  int n;
  printf ("digite um numero: ");
  scanf ("%d", &n);
  printf ("pares em ordem crescente de 0 a %d:", n);
  pares (n);
}

void pares (int n){
  if (n==0){
    printf ("%d", n);
  }
  else {
    pares (n-1);
    if (n%2==0){
      printf ("%d", n);
    }
  }
}
