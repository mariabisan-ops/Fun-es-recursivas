#include <stdio.h>

int tribonacci (int);

int main (){
  int n;
  printf ("digite um valor: ");
  scanf ("%d", &n);
  printf ("n-esimo termo da sequencia: %d", tribonacci(n));
}

int tribonacci (int n){
  if (n == 0){
    return 0;
  }
  if (n == 1){
    return 0;
  } 
  if (n == 2){
    return 1;
  }
  else {
    return tribonacci (n-1)+ tribonacci (n-2)+ tribonacci (n-3);
  }
}
