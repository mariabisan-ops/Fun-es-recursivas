#include <stdio.h>

void inverteVetor (int v[], int);

int main (){
  int v[100];
  printf (“preencha vetor: “);
  for (int i=0; i<100; i++){
    scanf (“%d”, &v[i]);
  }
  printf (“inversão: “);
  inverteVetor (v, 100);
  for (int i=0; i<100; i++){
    printf (“%d “, v[i]);
  }
}

void inverteVetor (int v[], int n){
  int aux;
  if (n==1){
    return;
  }
  if (n==2){
    aux = v[0];
    v[0] = v[1];
    v[1] = aux;
  }
  else {
    aux = v[0];
    v[0] = v[n-1];
    v[n-1] = aux;
    inverteVetor (v+1, n-2);
  }
}
